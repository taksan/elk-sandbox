# Docker Socket Configuration
# For rootless Docker, set DOCKER_SOCK to your user's Docker socket path
# Example for rootless Docker (replace 1000 with your UID):
# DOCKER_SOCK=/run/user/1000/docker.sock

# For standard Docker (default if not set):
# DOCKER_SOCK=/var/run/docker.sock

# Fake Traffic Generator Configuration
# Port mappings (currently hardcoded in docker-compose.yml)
# TRAFFIC_GENERATOR_PORT=8000
# USER_DATABASE_PORT=8500
# SERVER_ASSIGNMENT_PORT=8100

# Network configuration
# The fake-traffic-generator services will join the ELK monitoring network
NETWORK_NAME=elk_net

# Configuration files
USER_FLOWS_FILE=./user_flows.yml
GEO_SERVERS_FILE=./geo_servers.geojson

# Logging configuration: All services use GELF driver to send logs to Logstash
